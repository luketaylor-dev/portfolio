# Set to "true" to enable debug logging (LCP, page load, etc.)
DEBUG=false

# For client-side debug (e.g. performance logs in browser console)
NEXT_PUBLIC_DEBUG=false

# EmailJS - see SECURE_EMAILJS_SETUP.md for setup
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PROJECT_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=

# Site URL - used for canonical links, sitemap, metadata, robots.txt, etc.
# Set to your production domain when deploying (e.g. https://yourdomain.com)
SITE_URL=https://www.dibza.co.uk
